# syntax=docker/dockerfile:1

FROM golang:1.26.6-alpine AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /usr/local/bin/tael-bot ./app
RUN mkdir -p /data

FROM gcr.io/distroless/static-debian13:nonroot
ENV TAELBOT_ENV=production
ENV DATA_DIR=/data
VOLUME /data

COPY --from=builder --chown=65532:65532 /data /data
COPY --from=builder /usr/local/bin/tael-bot /usr/local/bin/tael-bot

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/tael-bot"]
